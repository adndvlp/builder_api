{
  "rules": {
    "sessions": {
      "$experimentID": {
        "$sessionId": {
          ".read": false,
          ".write": "!data.exists() || !data.child('finalizationProcessed').exists()",
          ".validate": "newData.hasChildren(['connected', 'experimentID', 'sessionId'])"
        }
      }
    }
  }
}
