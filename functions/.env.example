# Copy this file to functions/.env and fill in real values from each provider's
# developer console. functions/.env is gitignored.
#
# Firebase Functions v2 auto-loads functions/.env at runtime (emulator + deploy).
# For production secrets prefer Google Secret Manager via defineSecret(); these
# .env vars are acceptable for local development and short-term migration.

# Dropbox — https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Google Drive — https://console.cloud.google.com/apis/credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# OSF — https://osf.io/settings/applications/
OSF_CLIENT_ID=
OSF_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Project / domain configuration (T-3 migration).
# The OAuth callback for OSF is hard-registered with the OSF developer
# console — update both values together: change the URL here AND in the
# OSF app's "Callback URL" setting at https://osf.io/settings/applications.
# Other providers (Dropbox/Drive/GitHub) auto-resolve their callbacks via
# FIREBASE_APP_BASE_URL.
FIREBASE_PROJECT_ID=test-e4cf9
FIREBASE_APP_BASE_URL=https://test-e4cf9.firebaseapp.com
OSF_OAUTH_CALLBACK_URL=https://us-central1-test-e4cf9.cloudfunctions.net/osfOAuthCallback
OSF_POST_AUTH_REDIRECT_URL=https://test-e4cf9.firebaseapp.com/settings
